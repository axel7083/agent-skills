{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "skill": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "arm": {
      "type": "string",
      "enum": [
        "without",
        "with",
        "bundle"
      ]
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode"
      ]
    },
    "model": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "task": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "trial": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "works": {
      "type": "boolean"
    },
    "failureClass": {
      "type": "string",
      "enum": [
        "none",
        "no-artifact",
        "build",
        "start",
        "probe",
        "timeout",
        "infra"
      ]
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "na",
              "error"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "agentSeconds": {
      "type": "number",
      "minimum": 0
    },
    "agentReported": {
      "type": "object",
      "properties": {
        "triggered": {
          "type": "boolean"
        },
        "tokens": {
          "type": "object",
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cached": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "input",
            "cached",
            "output"
          ],
          "additionalProperties": false
        },
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "triggered",
        "tokens",
        "turns",
        "toolCalls"
      ],
      "additionalProperties": false
    },
    "graderCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "transcriptPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._/-]{0,255}$"
    }
  },
  "required": [
    "schemaVersion",
    "skill",
    "arm",
    "harness",
    "model",
    "task",
    "attempt",
    "trial",
    "works",
    "failureClass",
    "checks",
    "agentSeconds",
    "agentReported",
    "graderCommit",
    "transcriptPath"
  ],
  "additionalProperties": false
}
