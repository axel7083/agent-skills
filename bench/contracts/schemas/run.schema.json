{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "githubRunId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "abandoned"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "completedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "skillSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "skillVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "opencode"
            ]
          },
          "model": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          }
        },
        "required": [
          "harness",
          "model"
        ],
        "additionalProperties": false
      }
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "without",
          "with",
          "bundle"
        ]
      }
    },
    "trials": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "costUsd": {
      "type": [
        "number",
        "null"
      ]
    },
    "maxUsd": {
      "type": "number"
    },
    "verdicts": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "helps": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "noEffect": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "hurts": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "helps",
            "noEffect",
            "hurts"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "harness": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "opencode"
            ]
          },
          "model": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "arm": {
            "type": "string",
            "enum": [
              "without",
              "with",
              "bundle"
            ]
          },
          "task": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": [
          "id",
          "harness",
          "model",
          "arm",
          "task"
        ],
        "additionalProperties": false
      }
    },
    "billing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shard": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "costUsd": {
            "type": [
              "number",
              "null"
            ]
          },
          "gatewayTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "agentTokens": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "tokenMismatch": {
            "type": "boolean"
          }
        },
        "required": [
          "shard",
          "attempt",
          "costUsd",
          "gatewayTokens",
          "agentTokens",
          "tokenMismatch"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "runId",
    "githubRunId",
    "status",
    "createdAt",
    "completedAt",
    "skill",
    "skillSha",
    "skillVersion",
    "cells",
    "arms",
    "trials",
    "costUsd",
    "maxUsd",
    "verdicts",
    "tasks",
    "shards",
    "billing"
  ],
  "additionalProperties": false
}
