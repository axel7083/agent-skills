{
  "name": "@podman-desktop/agent-skills-bench-report",
  "version": "0.1.0",
  "private": true,
  "description": "The benchmark's run report: Vega-Lite charts over a run's results, served by the bench server",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@podman-desktop/agent-skills-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mockup": "node --conditions=@podman-desktop/agent-skills-source scripts/mockup.ts"
  },
  "dependencies": {
    "@podman-desktop/agent-skills-bench-contracts": "workspace:*",
    "vega": "catalog:",
    "vega-embed": "catalog:",
    "vega-interpreter": "catalog:",
    "vega-lite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "esbuild": "catalog:"
  }
}
