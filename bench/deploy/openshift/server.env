# The bench server's settings (bench/server/src/config/env.ts). Secrets are not here: see
# docs/benchmark.md "Deploying". These values trust axel7083/agent-skills, the fork the benchmark is
# brought up on; switch the three GITHUB_* values to podman-desktop/agent-skills upstream.
PUBLIC_URL=https://bench-prod-podman-desktop-agent-skills-bench.apps.ospo-osci.z3b1.p1.openshiftapps.com
# The same route: the edge passes /llm/… to Bifrost.
BIFROST_PUBLIC_URL=https://bench-prod-podman-desktop-agent-skills-bench.apps.ospo-osci.z3b1.p1.openshiftapps.com/llm
GITHUB_REPOSITORY=axel7083/agent-skills
GITHUB_REPOSITORY_ID=1444086302
GITHUB_OWNER_ID=42176370
ALLOWED_ACTOR_IDS=42176370
REQUIRE_PROTECTED_REF=true
BIFROST_ADMIN_URL=http://bench-bifrost:8080
BIFROST_ADMIN_USERNAME=bench
BIFROST_PROVIDER=enmaas
PRICES_FILE=/etc/bench/prices.json
MAX_RUN_USD=50
DAILY_USD=100
