{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "source_of_truth": "config.json",
  "client": {
    "enforce_auth_on_inference": true,
    "drop_excess_requests": true,
    "allow_direct_keys": false,
    "enable_logging": true,
    "disable_content_logging": true,
    "log_retention_days": 30,
    "allowed_origins": [],
    "allowed_headers": ["anthropic-beta", "anthropic-version"]
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bench-postgres",
      "port": "5432",
      "user": "bifrost",
      "password": "env.BIFROST_DB_PASSWORD",
      "db_name": "bifrost",
      "ssl_mode": "require"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "bench-postgres",
      "port": "5432",
      "user": "bifrost",
      "password": "env.BIFROST_DB_PASSWORD",
      "db_name": "bifrost",
      "ssl_mode": "require"
    }
  },
  "governance": {
    "auth_config": {
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "is_enabled": true
    }
  },
  "providers": {
    "enmaas": {
      "keys": [{ "name": "enmaas", "value": "env.ENMAAS_KEY", "models": ["*"], "weight": 1 }],
      "network_config": { "base_url": "https://api.enmaas.devshift.net" },
      "concurrency_and_buffer_size": { "concurrency": 16, "buffer_size": 16 },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true,
          "count_tokens": true
        }
      }
    }
  }
}
