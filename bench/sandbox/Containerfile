# The sandbox every agent works in: Fedora with Podman running inside a privileged container
# (nested), and the tools agents reach for. Harbor installs the agent CLI at run time. No grader,
# test or oracle is ever in here: grading happens in another job.
FROM quay.io/fedora/fedora:45@sha256:8430348a73c5a0e607b5de2cf9dd4741d9aa0891bbce3108588298102015f8c6

RUN dnf install -y --setopt=install_weak_deps=False \
      podman crun netavark aardvark-dns passt fuse-overlayfs skopeo \
      bash coreutils procps-ng findutils which tar gzip xz unzip diffutils \
      curl ca-certificates git jq ripgrep \
      nodejs npm \
      python3 python3-pyyaml \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf*

# Nested engine: no systemd inside, storage on a volume (no overlay on overlay), netavark bridge.
# Podman applies drop-ins after the main files, and Fedora's vendor drop-in selects journald
# (absent here, so `podman logs` would be empty): ours comes later.
COPY containers.conf /etc/containers/containers.conf.d/99-bench.conf
COPY storage.conf /etc/containers/storage.conf
VOLUME ["/var/lib/containers", "/var/tmp"]

WORKDIR /app
