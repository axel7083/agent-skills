{
  "name": "@podman-desktop/agent-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Skills for the Podman ecosystem, and the benchmark measuring their uplift",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "pnpm --recursive --sort run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "pnpm --recursive run gen",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
