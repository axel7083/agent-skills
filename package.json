{
  "name": "@podman-desktop/agent-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Skills for the Podman ecosystem, and the benchmark measuring their uplift",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "pnpm --recursive --sort run build",
    "typecheck": "pnpm generated && pnpm --recursive run typecheck",
    "lint": "pnpm generated && eslint --max-warnings 0 .",
    "test": "pnpm generated && vitest run",
    "test:watch": "vitest",
    "gen": "pnpm --recursive run gen",
    "check": "pnpm license && pnpm typecheck && pnpm lint && pnpm test",
    "generated": "pnpm --filter @podman-desktop/agent-skills-bench-server-client build",
    "license": "node scripts/license-headers.ts",
    "license:fix": "node scripts/license-headers.ts --fix"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
